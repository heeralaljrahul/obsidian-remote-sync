{
  "name": "gdrive-vault-sync",
  "version": "0.1.0",
  "description": "Personal Obsidian plugin that syncs a vault with Google Drive (desktop and iOS). Fork of remotely-sync.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs production && node scripts/check-bundle.mjs",
    "test": "mocha"
  },
  "keywords": [
    "obsidian",
    "google-drive",
    "sync"
  ],
  "license": "Apache-2.0",
  "dependencies": {
    "localforage": "^1.10.0",
    "spark-md5": "^3.0.2"
  },
  "devDependencies": {
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.10.2",
    "@types/spark-md5": "^3.0.5",
    "chai": "^4.5.0",
    "esbuild": "^0.25.0",
    "mocha": "^10.8.2",
    "obsidian": "^1.8.7",
    "tslib": "^2.8.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
