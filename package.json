{
  "name": "gdrive-vault-sync",
  "version": "0.1.0",
  "description": "Personal Obsidian plugin that syncs a vault with Google Drive (desktop and iOS). Fork of remotely-sync.",
  "author": "heeralaljrahul",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/heeralaljrahul/obsidian-remote-sync.git"
  },
  "main": "main.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs production && node scripts/check-bundle.mjs",
    "test": "tsc -p tsconfig.test.json && mocha",
    "version": "node scripts/version-bump.mjs && git add manifest.json versions.json",
    "test:fuzz": "FUZZ_STATS=1 FUZZ_SEEDS=${FUZZ_SEEDS:-3000} FUZZ_STEPS=${FUZZ_STEPS:-120} mocha --config .mocharc.fuzz.json",
    "test:e2e": "mocha --spec tests/e2e.test.ts --spec tests/callback.test.ts --no-config --node-option import=tsx --timeout 120000",
    "lint": "eslint . && prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" \"scripts/*.mjs\" \"*.mjs\" \"*.json\" \".github/**/*.yml\"",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"scripts/*.mjs\" \"*.mjs\" \"*.json\" \".github/**/*.yml\""
  },
  "keywords": [
    "obsidian",
    "google-drive",
    "sync"
  ],
  "dependencies": {
    "localforage": "^1.10.0",
    "spark-md5": "^3.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.10.2",
    "@types/spark-md5": "^3.0.5",
    "chai": "^4.5.0",
    "esbuild": "^0.25.0",
    "eslint": "^9.39.5",
    "mocha": "^12.0.3",
    "obsidian": "^1.8.7",
    "playwright": "^1.63.0",
    "prettier": "^3.10.1",
    "tslib": "^2.8.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.73.0"
  }
}
